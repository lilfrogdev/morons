{
  "name": "@morons/local-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src test package.json tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "oauth4webapi": "3.8.8",
    "@earendil-works/pi-ai": "1.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "prettier": "3.6.2",
    "@types/node": "22.19.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/local-service.d.ts",
      "import": "./dist/local-service.js"
    },
    "./node": {
      "types": "./dist/node-adapters.d.ts",
      "import": "./dist/node-adapters.js"
    },
    "./keychain": {
      "types": "./dist/keychain-broker.d.ts",
      "import": "./dist/keychain-broker.js"
    },
    "./provider": {
      "types": "./dist/pi-subscription.d.ts",
      "import": "./dist/pi-subscription.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "version": "0.1.0"
}
