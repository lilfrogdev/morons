{
  "name": "@morons/provisioning",
  "private": true,
  "type": "module",
  "exports": "./dist/src/index.js",
  "scripts": {
    "build": "tsc && node scripts/build-module.mjs",
    "build:backend": "node scripts/build-bundle.mjs",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src test scripts package.json tsconfig.json",
    "test": "npm run build && node --test dist/provisioning/test/*.test.js",
    "stdio": "node dist/src/bridge.js --stdio"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.14.1"
}
